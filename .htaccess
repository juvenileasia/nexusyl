Options -Indexes
Options +FollowSymLinks

RewriteEngine On

# ── Force www removal (serve from nexusyl.juvenileasia.com not www.)
# Uncomment if needed:
# RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
# RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# ── Serve Nexusyl_Fab.png as favicon.ico ─────────────────────────────────────
RewriteRule ^favicon\.ico$ /Nexusyl_Fab.png [L,R=301]

# ── Portal routes ────────────────────────────────────────────────────────────
RewriteRule ^login/?$               login.html [L]
RewriteRule ^dashboard-admin/?$     dashboard-admin.html [L]
RewriteRule ^dashboard-employee/?$  dashboard-employee.html [L]
RewriteRule ^dashboard-student/?$   dashboard-student.html [L]
RewriteRule ^dashboard-supplier/?$  dashboard-supplier.html [L]

# ── Explicit slug → filename mapping (where slug ≠ filename) ────────────────
RewriteRule ^food-tech/?$ foodtech.html [L]

# ── Remove .html extension from URLs ──────────────────────────────────────────
# Already accessed without extension — serve the file
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# ── Redirect .html requests to clean slug ─────────────────────────────────────
RewriteCond %{THE_REQUEST} \s/+(.*?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# ── Homepage: redirect /index to / ────────────────────────────────────────────
RewriteRule ^index/?$ / [R=301,L]

# ── Custom 404 ────────────────────────────────────────────────────────────────
ErrorDocument 404 /404.html

# ── Security headers ──────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Compression ───────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>

# ── Cache static assets ───────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png  "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css   "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>
