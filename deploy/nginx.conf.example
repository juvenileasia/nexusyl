# Example nginx config for unmanaged VPS (Apache/cPanel users: see SCALAHOSTING.md + root .htaccess)
# Marketing HTML at site root, React portal SPA under the same domain.
#
# Layout:
#   /var/www/nexusyl/                 marketing HTML
#   /var/www/nexusyl/portal/dist/     Vite build (index.html + assets/)
#
# Deploy steps: see deploy/SCALAHOSTING.md and scripts/deploy.sh

# Redirect HTTP → HTTPS (uncomment after Certbot)
# server {
#     listen 80;
#     server_name nexusyl.juvenileasia.com;
#     return 301 https://$host$request_uri;
# }

server {
    listen 80;
    server_name nexusyl.juvenileasia.com;
    root /var/www/nexusyl;
    index index.html;

    # Vite hashed bundles live under portal/dist/assets but the SPA
    # requests them from /assets/...
    location /assets/ {
        alias /var/www/nexusyl/portal/dist/assets/;
        expires 7d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # React portal SPA — all role dashboards + login
    location ~ ^/(login|dashboard-admin|dashboard-employee|dashboard-student|dashboard-supplier)(/.*)?$ {
        try_files /portal/dist/index.html =404;
    }

    # Marketing pages — clean URLs
    location = /food-tech {
        try_files /foodtech.html =404;
    }

    location / {
        try_files $uri $uri.html $uri/ =404;
    }

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}

# HTTPS: sudo certbot --nginx -d nexusyl.juvenileasia.com
# Certbot will generate the 443 server block for you.
